{
  "manifest_version": 3,
  "name": "extension with jev",
  "version": "0.0.1",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [],
  "background": {
    "service_worker": "background.ts"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content-script.ts"]
    }
  ]
}
